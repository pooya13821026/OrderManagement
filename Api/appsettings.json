{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=OrderManagementDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "_KeyNote": "Development-only signing key. Replace with a secret from user-secrets/environment configuration before deploying to production.",
    "Issuer": "OrderManagement",
    "Audience": "OrderManagementClients",
    "Key": "OrderManagement-Dev-Jwt-Signing-Key-ChangeMe-2026!",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Properties": {
      "Application": "OrderManagement.Api"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
