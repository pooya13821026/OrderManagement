            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orders\": [\n    {\n      \"customerId\": \"{{customerId}}\",\n      \"items\": [\n        {\n          \"productId\": \"{{productId}}\",\n          \"quantity\": 1\n        }\n      ],\n      \"notes\": \"سفارش گروهی ۱\"\n    },\n    {\n      \"customerId\": \"{{customerId}}\",\n      \"items\": [\n        {\n          \"productId\": \"{{productId}}\",\n          \"quantity\": 3\n        }\n      ],\n      \"notes\": \"سفارش گروهی ۲\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/Orders/BulkCreate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Orders", "BulkCreate"]
            },
            "description": "ایجاد گروهی ۲ سفارش در یک فراخوانی (پاسخ 200)؛ فقط مدیر (در غیر این صورت 403). لیست orders باید ۱ تا ۵۰۰ عضو داشته باشد. پاسخ شامل تعداد موفق/ناموفق و نتیجه‌ی تفکیکی هر سفارش (OrderId، OrderNumber یا ErrorMessage) است؛ خطای اعتبارسنجی کل payload هم 400 برمی‌گرداند."
          }
